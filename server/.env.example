# ============================================================================
# .env.example - CONFIGURATION DE SÉCURITÉ POUR AO Link
# ============================================================================
# COPIER CE FICHIER À ".env" ET REMPLIR LES VALEURS SÉCURISÉES
# ⚠️  NE JAMAIS COMMITTER LE FICHIER ".env" RÉEL
# ============================================================================

# 🔒 SÉCURITÉ CRITIQUE #1: JWT Secret
# Doit être une chaîne aléatoire de 64+ caractères (JAMAIS par défaut)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changez-moi-par-une-clé-aléatoire-de-64-caractères-minimum

# 🔒 SÉCURITÉ CRITIQUE #2: Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Exemples:
#   Local: postgresql://postgres:password@localhost:5432/aolink
#   Render: postgresql://user:password@dpg-xxx.render.com:5432/aolink
DATABASE_URL=postgresql://postgres:password@localhost:5432/aolink

# Connexion du proprietaire de schema, utilisee uniquement par npm run db:migrate.
# En production, DATABASE_URL utilise un role applicatif sans BYPASSRLS.
MIGRATION_DATABASE_URL=postgresql://schema_owner:password@localhost:5432/aolink

# Verrous obligatoires pour toute migration distante. La cible ne contient
# jamais le mot de passe : HOST[:PORT]/DATABASE.
ALLOW_REMOTE_MIGRATION=false
MIGRATION_CONFIRM_TARGET=host.example.com:5432/aolink
MIGRATION_BACKUP_REFERENCE=export-render-YYYY-MM-DD-HHMM
# Uniquement lors de la toute premiere transition si DATABASE_URL utilise
# encore le compte proprietaire. Remettre a false juste apres.
ALLOW_SHARED_MIGRATION_CREDENTIALS=false

# Tests d'integration PostgreSQL. Utiliser uniquement une copie jetable.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/aolink_test
ALLOW_TEST_DATABASE=false
TEST_DATABASE_CONFIRM_TARGET=localhost:5432/aolink_test

# 🔒 SÉCURITÉ CRITIQUE #3: CORS Whitelist
# Liste des origines autorisées (séparées par des virgules)
# Format: https://votresite.com,https://app.votresite.com
# ⚠️  Ne JAMAIS mettre "*" - les attaquants en profiteraient!
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://votresite.com

# 🔒 SÉCURITÉ CRITIQUE #4: Node Environment
# Valeurs: development, production
# En production: active les vérifications strictes
NODE_ENV=development

# Cloisonnement et entree de demonstration
PLATFORM_ADMIN_EMAIL=alban.michaud65@gmail.com
ALERT_EMAIL=alban.michaud65@gmail.com
DEMO_HOST=demo.ao-link.fr
DEMO_USER_EMAIL=demo@ao-link.fr
DEMO_USER_PASSWORD=changez-moi-avec-au-moins-12-caracteres

# 📧 Email Configuration (pour vérification de compte)
# Service: Gmail, Outlook, ou serveur SMTP personnalisé
EMAIL_USER=votre-email@votredomaine.com
EMAIL_PASS=votre-app-password

# 🟥 Redis (cache, sessions, rate-limiting)
# Si non défini, utilise redis://localhost:6379 par défaut
# En production (Render): utiliser l'URL du service Redis
REDIS_URL=redis://localhost:6379

# 🌐 Frontend URL (pour les liens de vérification email)
FRONTEND_URL=http://localhost:3000

# 📊 Port d'écoute
PORT=4000

# 🏢 Render.com (si déployé sur Render)
# Si votre app est sur Render, décommenter:
# RENDER=true
# Cela active automatiquement SSL/TLS et trust proxy

# 📝 Logging
LOG_LEVEL=info

# ============================================================================
# 📋 CHECKLIST AVANT PRODUCTION
# ============================================================================
# 
# ✅ JWT_SECRET: Clé aléatoire 64+ caractères
# ✅ DATABASE_URL: URL de base de données sécurisée (SSL/TLS)
# ✅ REDIS_URL: URL Redis (cache, rate-limiting, token blacklist)
# ✅ ALLOWED_ORIGINS: JAMAIS "*", liste explicite seulement
# ✅ NODE_ENV: "production"
# ✅ EMAIL_USER/PASSWORD: Configuré ou vide (emails optionnels)
# ✅ FRONTEND_URL: URL HTTPS de votre frontend
# ✅ .env: Ajouté à .gitignore (ne JAMAIS committer)
#
# ⚠️  AVANT DE DÉPLOYER:
# 1. Vérifier que .env n'existe pas en repo (git rm --cached .env)
# 2. Ajouter .env à .gitignore
# 3. Tester: npm start (vérifier tous les logs ✅)
# 4. Lancer: ./test-security.sh (tous les tests PASSED)
# 5. En production: Utiliser secrets manager (pas de fichier .env)
#
# ============================================================================
