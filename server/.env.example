# Configuration de la base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tao_db

# Secret pour JWT (min 32 caractères) - CHANGEZ CETTE VALEUR !
JWT_SECRET=votre-secret-jwt-tres-long-et-securise-changez-moi-absolument

# Origines CORS autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Configuration SSL pour la base de données
# DB_SSL=true  # Décommenter pour activer SSL en développement
# NODE_ENV=production  # Pour activer les vérifications strictes

# Port du serveur (optionnel, défaut: 4000)
PORT=4000

# Création automatique du compte admin au démarrage (optionnel)
# Si non défini, vous devrez créer l'admin via l'interface
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
